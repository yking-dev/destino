```gitignore
# Dependencies
node_modules/

# Production build
dist/
build/

# Vite
.vite/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# OS generated files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp

# Coverage
coverage/

# TypeScript
*.tsbuildinfo

# Miscellaneous
.cache/
.parcel-cache/
```
